
# ──────────────────────────────────────────────────────────────
#  Flask / Session
# ──────────────────────────────────────────────────────────────
FLASK_APP=app.py
FLASK_ENV=production          # change to "development" when debugging
SECRET_KEY=super-duper-ultra-secret-change-me-in-production

# ──────────────────────────────────────────────────────────────
#  Database
# ──────────────────────────────────────────────────────────────
SQLALCHEMY_DATABASE_URI=sqlite:///users.db
SQLALCHEMY_TRACK_MODIFICATIONS=False

# ──────────────────────────────────────────────────────────────
#  Uploads & Sessions
# ──────────────────────────────────────────────────────────────
UPLOAD_FOLDER=private_uploads
SESSION_TYPE=filesystem
SESSION_FILE_DIR=flask_session

